---
import Layout from "../layouts/Layout.astro";
import { LINKS } from "../config/links";
import { withReferral } from "../lib/referral";

// The QR codes point here, and everyone who scans one is heading for the walk sign-in, so
// this page sends them straight to the registration form. The full list of links is still
// at /links/.
const signup = LINKS.find((l) => l.id === "signup")!;
// Tagged with the defaults at build time; the script below re-tags it before leaving.
const fallback = withReferral(signup.href);
---

<Layout title="Birds Connect Seattle — walk sign-in">
  <!-- Without JavaScript, go straight away with the default tags. -->
  <noscript><meta http-equiv="refresh" content={`0; url=${fallback}`} /></noscript>
  <main class="mx-auto flex max-w-md flex-1 flex-col items-center justify-center gap-3 px-4 text-center">
    <p class="text-lg font-semibold text-brand">Taking you to the walk sign-in…</p>
    <a id="signup" href={fallback} data-tracked={signup.href} class="text-ink underline underline-offset-2">
      Tap here if nothing happens
    </a>
  </main>
</Layout>

<script>
  import { eventTag, fetchActiveEvent } from "../lib/activeEvent";
  import { withReferral } from "../lib/referral";

  // Same tagging as the link hub: ?src= always wins, otherwise whichever NextGen event is on
  // right now. The calendar only gets a moment to answer, since the person is waiting.
  const link = document.getElementById("signup") as HTMLAnchorElement;
  const src = new URLSearchParams(location.search).get("src");
  const tag = src
    ? Promise.resolve(src)
    : fetchActiveEvent(Date.now(), 1500).then((e) => (e ? eventTag(e) : null));
  // replace(), so the back button doesn't land on this page and bounce forward again.
  tag.then((t) => location.replace(withReferral(link.dataset.tracked!, t)));
</script>
