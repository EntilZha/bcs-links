---
import { SOCIALS, type SocialLink } from "../config/links";

// Simplified glyphs, drawn on a 24×24 grid.
const ICONS: Record<SocialLink["id"], string> = {
  instagram: `<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.3" fill="currentColor"/>`,
  facebook: `<path fill="currentColor" d="M13.4 21.5v-8h2.7l.4-3.2h-3.1V8.3c0-.9.3-1.6 1.6-1.6h1.7V3.9a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2H10v8Z"/>`,
  youtube: `<rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor"/><path d="M10 8.8v6.4l5.5-3.2Z" fill="var(--color-cream)"/>`,
};
---

<ul class="flex justify-center gap-3" aria-label="Birds Connect Seattle on social media">
  {
    SOCIALS.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          data-link={s.id}
          class="grid size-13 place-items-center rounded-full bg-white text-brand shadow-sm ring-1 ring-sage/50 transition hover:bg-brand hover:text-pop active:scale-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-leaf"
        >
          <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" set:html={ICONS[s.id]} />
        </a>
      </li>
    ))
  }
</ul>
